# Tracking store. The sqlite path is relative to the process working directory,
# so run scripts/train.py and uvicorn from the same directory (the repo root).
# Metadata goes to ./mlflow.db, artifacts to ./mlruns (MLflow's default root).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# The API serves models:/<registered model>@<alias>, which scripts/train.py
# moves after each run. Defaults shown; override to serve a second alias
# (e.g. challenger) from the same registry.
# REGISTERED_MODEL_NAME=severity-classifier
# MODEL_ALIAS=champion
# Optional: pin an exact model, bypassing the alias entirely,
# e.g. models:/severity-classifier/3 or runs:/<run_id>/severity_classifier
# MODEL_URI=
