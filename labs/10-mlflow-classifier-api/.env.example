# Tracking store. The sqlite path is relative to the process working directory,
# so run scripts/train.py and uvicorn from the same directory (the repo root).
# Metadata goes to ./mlflow.db, artifacts to ./mlruns (MLflow's default root).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Optional: pin an exact model instead of serving the latest finished run,
# e.g. runs:/<run_id>/severity_classifier
# MODEL_URI=
